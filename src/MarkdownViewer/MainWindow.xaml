<Window x:Class="MarkdownViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markdown Viewer"
        Width="900" Height="700"
        WindowState="Maximized"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#F3F3F3">
            <Button x:Name="SetAsDefaultButton"
                    Content="Definir como visualizador padrão de .md"
                    Margin="6" Padding="8,4"
                    Click="SetAsDefaultButton_Click" />
            <Button x:Name="OpenFileButton"
                    Content="Abrir arquivo (Ctrl+O)"
                    Margin="6" Padding="8,4"
                    Click="OpenFileButton_Click" />
        </StackPanel>
        <wv2:WebView2 x:Name="WebView" />
    </DockPanel>
</Window>
